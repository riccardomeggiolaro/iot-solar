# Copia questo file in .env e modifica i valori (gli installer lo fanno da soli)

# Immagine (registry privato GitHub) e versione da installare (latest o es. 0.2.0)
IOT_SOLAR_IMAGE=ghcr.io/riccardomeggiolaro/iot-solar
IOT_SOLAR_TAG=latest

# Fuso orario del container
TZ=Europe/Rome

# Cartelle persistenti sull'host
# - config.json
IOT_SOLAR_CONFIG_DIR=/etc/iot-solar
# - database storico, chiave delle sessioni
IOT_SOLAR_DATA_DIR=/var/opt/iot-solar

# Password iniziale dell'utente "admin" (usata solo al primo avvio, poi va cambiata dal web)
IOT_SOLAR_ADMIN_PASSWORD=cambiami
